# Next.js public configuration (local development default)
NEXT_PUBLIC_SIGNALING_URL=http://localhost:3001

# Optional TURN fallback: server-only values; replace placeholders before enabling
# METERED_DOMAIN=your-app.metered.live
# METERED_TURN_API_KEY=your-credential-api-key

# Signaling process only: set in its shell or hosting environment.
# npm run signal does not load this file automatically.
# Production requires explicit origins; development defaults to localhost:3000 and 127.0.0.1:3000.
# NODE_ENV=production
# CLIENT_ORIGIN=https://your-app.example
# SIGNAL_PORT=3001
# PORT=3001

# Optional Send for later: server-only Supabase credentials
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-service-role-key
# CRON_SECRET=replace-with-at-least-32-random-characters
